pipeline {

    agent any

    environment {
        GCP_PROJECT = 'project-76bbd5c2-25dc-4eb3-a36'
        GCP_REGION  = 'asia-south1'
        GKE_CLUSTER = 'devops-gke'

        IMAGE_REPO = 'ghcr.io/rajeshku1997/devops-app'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Unit Test') {
            steps {
                dir('application') {
                    sh '''
                        python3 --version
                        python3 -m pip --version

                        python3 -m pytest tests/
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    sh """
                        docker build \
                          -t ${IMAGE_REPO}:${IMAGE_TAG} \
                          ./application
                    """
                }
            }
        }

        stage('Security Scan') {
            steps {
                sh '''
                    echo "Security scanning stage"
                    echo "Trivy integration will be added here"
                '''
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'ghcr-creds',
                        usernameVariable: 'GHCR_USER',
                        passwordVariable: 'GHCR_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "$GHCR_TOKEN" | docker login ghcr.io \
                          -u "$GHCR_USER" \
                          --password-stdin

                        docker push ${IMAGE_REPO}:${IMAGE_TAG}

                        docker logout ghcr.io
                    '''
                }
            }
        }

        stage('Deploy to GKE') {
            steps {
                sh '''
                    gcloud container clusters get-credentials \
                      ${GKE_CLUSTER} \
                      --region ${GCP_REGION} \
                      --project ${GCP_PROJECT}

                    kubectl set image deployment/devops-app \
                      devops-app=${IMAGE_REPO}:${IMAGE_TAG} \
                      -n application
                '''
            }
        }

        stage('Rollout Verification') {
            steps {
                sh '''
                    kubectl rollout status deployment/devops-app \
                      -n application \
                      --timeout=5m
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                sh '''
                    kubectl get pods -n application
                    kubectl get svc -n application

                    echo "Application deployment completed successfully"
                '''
            }
        }
    }

    post {

        success {
            echo 'Application CI/CD pipeline completed successfully.'
        }

        failure {
            echo 'Application CI/CD pipeline failed.'
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}
